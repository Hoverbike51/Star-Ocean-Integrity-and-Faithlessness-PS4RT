#include <windows.h>
#include "resource.h"
#include "ps4rt_version.h"
1 RT_MANIFEST "../packaging/windows/ps4rt.manifest"
IDI_APP_ICON ICON "assets/ps4rt-star-ocean.ico"
1 VERSIONINFO
 FILEVERSION PS4RT_VERSION_RESOURCE
 PRODUCTVERSION PS4RT_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HoverMods Vault\0"
      VALUE "FileDescription", "STAR OCEAN 5 Native Update Installer\0"
      VALUE "FileVersion", PS4RT_VERSION_STRING "\0"
      VALUE "InternalName", "SO5-Updater\0"
      VALUE "OriginalFilename", "SO5-Updater.exe\0"
      VALUE "ProductName", "STAR OCEAN 5 - PS4RT Windows\0"
      VALUE "ProductVersion", PS4RT_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
