#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "../packaging/windows/ps4rt.manifest"
IDI_APP_ICON ICON "assets/ps4rt-star-ocean.ico"

1 VERSIONINFO
 FILEVERSION 0,3,5,0
 PRODUCTVERSION 0,3,5,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PS4RT Community\0"
      VALUE "FileDescription", "PS4RT ShadPS4Plus PKG Extractor\0"
      VALUE "FileVersion", "0.3.5\0"
      VALUE "InternalName", "PS4RT-PkgExtractor\0"
      VALUE "OriginalFilename", "PS4RT-PkgExtractor.exe\0"
      VALUE "ProductName", "STAR OCEAN 5 - PS4RT Windows\0"
      VALUE "ProductVersion", "0.3.5\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
