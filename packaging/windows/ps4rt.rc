#include <winuser.h>
#include "ps4rt_version.h"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "ps4rt.manifest"
101 ICON "../../launcher/assets/ps4rt-star-ocean.ico"

1 VERSIONINFO
 FILEVERSION PS4RT_VERSION_RESOURCE
 PRODUCTVERSION PS4RT_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HoverMods Vault\0"
      VALUE "FileDescription", "STAR OCEAN: Integrity and Faithlessness\0"
      VALUE "FileVersion", PS4RT_VERSION_STRING "\0"
      VALUE "InternalName", "Star Ocean 5\0"
      VALUE "OriginalFilename", "Star Ocean 5.exe\0"
      VALUE "ProductName", "STAR OCEAN: Integrity and Faithlessness\0"
      VALUE "ProductVersion", PS4RT_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
